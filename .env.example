# ---------- Stackbrief settings (copy to .env, chmod 600) ----------
# Name shown in reports and in the AI's instructions
STACKBRIEF_HOST=my-server
TZ=America/New_York
# Daily scan time (HH:MM, in TZ). RUN_ON_START=true also scans when the container starts.
SCHEDULE=07:15
RUN_ON_START=false

# Shared secret between scanner and gateway: openssl rand -hex 32
GATEWAY_KEY=

# AI login - set ONE of these:
#   ANTHROPIC_API_KEY        from console.anthropic.com (pay per use)
#   CLAUDE_CODE_OAUTH_TOKEN  from `claude setup-token` (uses a Claude subscription; check Anthropic's
#                            terms for your plan before using it for unattended automation)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: CLAUDE_MODEL=claude-sonnet-5-5

# Delivery: comma list of smtp, ntfy, webhook, stdout
NOTIFY=stdout
# smtp (curl URL form; smtps://host:465 or smtp://host:587 - TLS is required)
SMTP_URL=smtps://smtp.example.com:465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=stackbrief@example.com
MAIL_TO=you@example.com
# ntfy (the report is attached as a text file)
NTFY_URL=https://ntfy.sh/your-private-topic
NTFY_TOKEN=
# webhook: POST {"subject": "...", "text": "..."}
WEBHOOK_URL=
# Optional: URL to GET after each successful run (e.g. an Uptime Kuma push monitor)
HEARTBEAT_URL=

# Tuning (defaults shown)
# SEVERITY=HIGH,CRITICAL
# REPORT_KEEP_DAYS=60
# GATEWAY_TIMEOUT=900
